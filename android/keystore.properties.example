// 正式发布签名配置
// 使用方法:
// 1. 生成正式keystore: keytool -genkey -v -keystore jingyingbao.keystore -alias jingyingbao -keyalg RSA -keysize 2048 -validity 36500
// 2. 将jingyingbao.keystore放到 android/app/ 目录
// 3. 复制本文件为 keystore.properties 并填入实际密码
// 4. 注意: keystore.properties 和 *.keystore 已被.gitignore忽略,不会提交到仓库

storeFile=jingyingbao.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=jingyingbao
keyPassword=YOUR_KEY_PASSWORD
