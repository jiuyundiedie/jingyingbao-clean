{
  "expo": {
    "name": "经营宝",
    "slug": "jingyingbao",
    "version": "5.85.1",
    "sdkVersion": "57.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./assets/icon.png",
      "bundleIdentifier": "com.jingyingbao.app",
      "infoPlist": {
        "NSCameraUsageDescription": "经营宝需要访问相机以进行扫码核销和拍摄商品照片",
        "NSPhotoLibraryUsageDescription": "经营宝需要访问相册以选择商品图片和聊天图片",
        "NSMicrophoneUsageDescription": "经营宝需要访问麦克风以进行语音通话和语音识别",
        "NSSpeechRecognitionUsageDescription": "经营宝需要语音识别权限以提供语音助手功能"
      }
    },
    "android": {
      "package": "com.jingyingbao.app",
      "versionCode": 176,
      "icon": "./assets/icon.png",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#1A5F8B"
      },
      "permissions": [
        "CAMERA",
        "INTERNET",
        "RECORD_AUDIO",
        "VIBRATE",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ]
    },
    "extra": {
      "eas": {
        "projectId": "dc956f10-0190-4a1e-964d-a2d24e6a17cc"
      }
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-speech-recognition",
      [
        "expo-camera",
        {
          "cameraPermission": "允许访问相机以进行扫码和拍照",
          "microphonePermission": "允许访问麦克风以进行视频通话"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择图片",
          "cameraPermission": "允许访问相机以拍摄照片"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#5B6DF0"
        }
      ]
    ]
  }
}