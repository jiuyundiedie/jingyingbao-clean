# 经营宝 环境变量示例
# 复制本文件为 .env 并填入实际的API Key
# 注意: .env 文件已被 .gitignore 忽略,不会提交到仓库
# CI/CD 构建时使用 GitHub Secrets 注入这些变量

# 阿里云百炼 (DashScope) - 视觉识别/AI对话
EXPO_PUBLIC_ALIBABA_API_KEY=your_alibaba_api_key_here

# 硅基流动 SiliconFlow - AI对话/视觉识别
EXPO_PUBLIC_SILICONFLOW_API_KEY=your_siliconflow_api_key_here

# 豆包AI (火山引擎) - AI对话
EXPO_PUBLIC_DOUBAO_API_KEY=your_doubao_api_key_here

# 智谱AI - AI对话/图像生成
EXPO_PUBLIC_ZHIPU_API_KEY=your_zhipu_api_key_here

# 百度AI - 图像识别
EXPO_PUBLIC_BAIDU_API_KEY=your_baidu_api_key_here
EXPO_PUBLIC_BAIDU_SECRET_KEY=your_baidu_secret_key_here
